# =============================================================================
# SACRÉ SHOP - Variables de Entorno
# =============================================================================
# Copia este archivo a .env.local y completa con tus credenciales.
# NO pongas valores reales aquí: es solo la plantilla documentada.
# Referencia 1:1: cada variable se consume directamente en el código
# (buscar `process.env.<VAR>`). Verifiers: tsc + vitest + git status.
# =============================================================================

# ============================================
# SUPABASE (https://supabase.com)
#   Consumidas en: lib/supabase/client.ts
# ============================================
# URL pública del proyecto (Dashboard > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Anon public key. Pública, va en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
# Service role key. SOLO servidor, NUNCA exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ============================================
# MERCADOPAGO (https://mercadopago.com.ar)
#   Consumidas en: app/api/orders/create/route.ts,
#                  app/api/webhooks/mercadopago/route.ts
# ============================================
# Access token de integración (producción).
MERCADOPAGO_ACCESS_TOKEN=tu-access-token-aqui
# Par de credenciales de la aplicación MercadoPago. Actualmente NO se leen en
# el código; se documentan para el setup OAuth/credenciales de la integración.
MERCADOPAGO_CLIENT_ID=tu-client-id-aqui
MERCADOPAGO_CLIENT_SECRET=tu-client-secret-aqui
# Secreto del webhook de MercadoPago. Verifica la firma x-signature (HMAC)
# de las notificaciones en app/api/webhooks/mercadopago/route.ts.
MERCADOPAGO_WEBHOOK_SECRET=tu-webhook-secret-aqui

# ============================================
# RESEND - Emails (https://resend.com)
#   Consumidas en: lib/email/resend.ts
# ============================================
RESEND_API_KEY=tu-resend-api-key-aqui
# Remitente verificado. En sandbox usar `onboarding@resend.dev`; un dominio
# verificado cuando exista (lib/email/resend.ts).
EMAIL_FROM=SACRE <tu-remitente-aqui>

# ============================================
# SITIO
#   Consumida en: app/api/orders/create/route.ts
# ============================================
# URL pública del sitio, para construir links de pago. Fallback: localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000