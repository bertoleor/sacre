# =============================================================================
# SACRÉ SHOP - Variables de Entorno
# =============================================================================
# Copia este archivo a .env.local y completa con tus credenciales
# =============================================================================

# ============================================
# SUPABASE (https://supabase.com)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ============================================
# MERCADOPAGO (https://mercadopago.com.ar)
# ============================================
MERCADOPAGO_ACCESS_TOKEN=tu-access-token-aqui
MERCADOPAGO_CLIENT_ID=tu-client-id-aqui
MERCADOPAGO_CLIENT_SECRET=tu-client-secret-aqui

# ============================================
# RESEND - Emails (https://resend.com)
# ============================================
RESEND_API_KEY=tu-resend-api-key-aqui

# ============================================
# SITIO
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
